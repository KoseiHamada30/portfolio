---
import { ClientRouter } from 'astro:transitions';
import { t, url, otherLocale, pathWithoutLocale, type Locale } from '../lib/i18n';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import Cursor from '../components/Cursor.astro';

import '@fontsource-variable/inter';
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/geist-mono/400.css';
// Japanese fonts: imported by /ja/ pages via <JaFonts /> only.

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/typography.css';
import '../styles/motion.css';
import '../styles/components.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Sets the per-project accent via [data-project]. */
  project?: string;
  /** Internal pages (/lab, /styleguide) stay out of search results. */
  noindex?: boolean;
  /** False when the page has no other-language version: no hreflang link, no language toggle. */
  alternate?: boolean;
  /** 'stage' = the dark Work stage (DESIGN.md §8): light nav, no footer. */
  surface?: 'paper' | 'stage';
}

const { locale, title, description, project, noindex = false, alternate = true, surface = 'paper' } = Astro.props;
const path = pathWithoutLocale(Astro.url.pathname);
const siteName = t(locale, 'site.name');
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} — ${t(locale, 'site.role')}`;
const metaDescription = description ?? t(locale, 'site.description');
const alt = otherLocale(locale);
const canonical = new URL(url(locale, path), Astro.site);
const altHref = url(alt, path);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={alt} href={new URL(altHref, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {
      locale === 'en' && alternate && (
        <script is:inline define:vars={{ altHref }}>
          // Returning visitors who chose Japanese land on the Japanese page (DESIGN.md §5.8).
          // Checked once per session, so in-site navigation is never redirected.
          try {
            if (!sessionStorage.getItem('locale-checked')) {
              sessionStorage.setItem('locale-checked', '1');
              if (localStorage.getItem('locale') === 'ja') location.replace(altHref);
            }
          } catch {}
        </script>
      )
    }
    <ClientRouter />
  </head>
  <body data-project={project} data-surface={surface}>
    <slot name="overlay" />
    <a class="skip-link" href="#main">{t(locale, 'a11y.skip')}</a>
    <Nav locale={locale} alternate={alternate} />
    <main id="main">
      <slot />
    </main>
    {surface !== 'stage' && <Footer locale={locale} />}
    <Toast />
    <Cursor locale={locale} />
    <script>
      import { startLifecycle } from '../lib/lifecycle';
      import { startNav } from '../lib/nav';
      import { startCursor } from '../lib/cursor';
      import { startLangToggle } from '../lib/lang';
      import '../lib/reveal';
      import '../lib/magnetic';
      import '../lib/marquee';
      import '../lib/footer';
      import '../lib/stage';
      import '../lib/splash'; // last: its onPage hook runs after the page modules
      startLifecycle();
      startNav();
      startCursor();
      startLangToggle();
    </script>
  </body>
</html>
