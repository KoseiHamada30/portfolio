---
// Drag-to-compare slider. A native range input drives it, so it works with keyboard and touch
// (case.ts mirrors the value into --pos).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { t, text, localeOf, type Text } from '../../lib/i18n';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  alt: Text;
}

const locale = localeOf(Astro.currentLocale);
const { before, after, alt } = Astro.props;
const label = text(locale, alt);
---

<figure class="before-after" style="--pos: 50%" data-before-after data-reveal="fade">
  <Image src={after} alt={`${t(locale, 'case.after')}: ${label}`} widths={[800, 1600]} sizes="(min-width: 1100px) 52rem, 92vw" loading="lazy" />
  <div class="before-after__before">
    <Image src={before} alt={`${t(locale, 'case.before')}: ${label}`} widths={[800, 1600]} sizes="(min-width: 1100px) 52rem, 92vw" loading="lazy" />
  </div>
  <span class="before-after__handle" aria-hidden="true"></span>
  <input type="range" min="0" max="100" value="50" aria-label={t(locale, 'case.beforeAfter')} />
</figure>

<style>
  .before-after {
    position: relative;
    margin: var(--space-7) 0 0;
    overflow: hidden;
  }

  .before-after :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .before-after__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .before-after__handle {
    position: absolute;
    inset: 0 auto 0 var(--pos);
    width: 2px;
    background: var(--paper-0);
    translate: -1px 0;
    pointer-events: none;
  }

  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  input:focus-visible + .before-after__handle,
  .before-after:focus-within .before-after__handle {
    outline: 2px solid var(--ink-900);
  }
</style>
