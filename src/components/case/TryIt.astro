---
// "Try it" card (Kosei 2026-11-03: bigger so the prototype gets attention, but plain: no accent
// highlight, label or full-screen link): a large heading, a short intro (slot) and the embed.
//   <TryIt embed="prototypes/nba-research-lab.html" title="…" height="…">intro</TryIt>
import Media from './Media.astro';
import { t, localeOf, type Text } from '../../lib/i18n';

interface Props {
  embed: string;
  title: Text;
  height?: string;
}

const locale = localeOf(Astro.currentLocale);
const { embed, title, height } = Astro.props;
---

<section class="try" aria-labelledby="try-it" data-reveal="fade">
  <h3 class="try__title" id="try-it">{t(locale, 'case.tryIt')}</h3>
  <div class="try__intro"><slot /></div>
  <Media embed={embed} title={title} height={height} />
</section>

<style>
  .try {
    margin: var(--space-8) 0 0;
    padding: var(--space-7) var(--space-6) var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-0);
  }

  .try__title {
    margin: 0;
    font-size: var(--fs-h1);
    line-height: var(--lh-head);
    letter-spacing: var(--tracking-head);
  }

  .try__intro {
    max-width: var(--text-width);
    font-size: var(--fs-body-lg);
  }

  .try__intro :global(p) {
    margin: var(--space-4) 0 0;
  }

  .try :global(.media) {
    margin-top: var(--space-6);
  }

  .try :global(iframe) {
    background: transparent;
  }

  @media (max-width: 760px) {
    .try {
      padding: var(--space-6) var(--space-4) var(--space-4);
    }
  }
</style>
