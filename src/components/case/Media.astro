---
// Image, video or embed with an optional caption (DESIGN.md §6).
//   <Media src={img} alt={{ en, ja }} />                          image (astro:assets)
//   <Media src={{ en: imgEn, ja: imgJa }} … />                    image that differs by language
//   <Media video="media/circula/listview.mp4" frame="phone" />    muted loop; plays only while
//                                                                 centred in the viewport (case.ts);
//                                                                 poster = same name .jpg
//   <Media embed="https://embed.figma.com/…" title="…" />         lazy iframe (Figma prototypes)
//   <Media embed="prototypes/nba-research-lab.html" height="…" />   local prototype from public/
// size: "content" (column width, default) | "medium" (max 720px) | "narrow" (max 600px), centred
//       | "wide" (desktop: grows left over the reading rail to the page margin).
// Wrap several in <div class="media-row"> to sit them side by side.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { t, text, localeOf, type Text } from '../../lib/i18n';
import LinkBullet from '../LinkBullet.astro';

interface Props {
  src?: ImageMetadata | { en: ImageMetadata; ja: ImageMetadata };
  video?: string;
  embed?: string;
  alt?: Text;
  title?: Text;
  caption?: Text;
  frame?: 'phone' | 'none';
  size?: 'content' | 'medium' | 'narrow' | 'wide';
  /** CSS height for an embed (overrides the Figma player height). */
  height?: string;
}

const locale = localeOf(Astro.currentLocale);
const { src, video, embed, alt, title, caption, frame = 'none', size = 'content', height } = Astro.props;
const label = alt ? text(locale, alt) : '';
const image = src && 'en' in src && 'ja' in src && !('src' in src) ? src[locale] : (src as ImageMetadata | undefined);
const widths = size === 'wide' ? [800, 1200, 1600, 2400] : size === 'content' ? [800, 1200, 1600] : [600, 900, 1400];
const sizes =
  size === 'narrow' ? '600px' : size === 'medium' ? '720px' : size === 'wide' ? '(min-width: 1100px) min(92vw, 1330px), 92vw' : '(min-width: 1100px) 52rem, 92vw';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Figma prototypes also get a plain link: some hosts block embedded frames.
// A local embed (a prototype in public/) is served under the base.
const localEmbed = embed && !/^https?:/.test(embed) ? `${base}${embed}` : null;
const figmaLink = embed?.includes('embed.figma.com') ? embed.replace('embed.figma.com', 'www.figma.com').replace(/&?embed-host=[^&]*/, '') : null;
---

<figure class:list={['media', `media--${size}`, `media--frame-${frame}`, { 'media--embed': embed }]} data-reveal="fade">
  {image && <Image src={image} alt={label} widths={widths} sizes={sizes} loading="lazy" decoding="async" />}
  {
    video && (
      <div class="media__video">
        <video
          src={`${base}${video}`}
          poster={`${base}${video.replace(/\.mp4$/, '.jpg')}`}
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={label}
          data-centre-play
        />
      </div>
    )
  }
  {
    embed && (
      <iframe src={localEmbed ?? embed} title={title ? text(locale, title) : label} loading="lazy" allowfullscreen style={height ? `height:${height}` : undefined} />
    )
  }
  {
    figmaLink && (
      <p class="media__link">
        <LinkBullet href={figmaLink} external locale={locale}>{t(locale, 'case.openFigma')}</LinkBullet>
      </p>
    )
  }
  {caption && <figcaption>{text(locale, caption)}</figcaption>}
</figure>

<style>
  .media {
    margin: var(--space-7) 0 0;
  }

  .media--narrow {
    max-width: 600px;
    margin-inline: auto;
  }

  .media--medium {
    max-width: 720px;
    margin-inline: auto;
  }

  /* Kosei 2026-11-03: big overview images. The text column sits right-aligned in the case grid, so
     pull left by (content width − column width) to reach the page margin; above the sticky rail. */
  @media (min-width: 1101px) {
    .media--wide {
      position: relative;
      z-index: 2;
      margin-left: calc(100% - (min(100vw, var(--max-width)) - 2 * var(--page-margin)));
    }
  }

  /* side by side (MDX: <div class="media-row">…</div>) */
  :global(.media-row) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: var(--gutter);
  }

  :global(.media-row) > .media {
    flex: 1 1 0;
    min-width: min(100%, 220px);
  }

  :global(.media-row) > .media--frame-phone {
    flex: 0 1 auto;
  }

  .media :global(img) {
    width: 100%;
    height: auto;
  }

  /* Screen recordings in a phone-shaped frame (v1: 180–220px wide) */
  .media--frame-phone .media__video {
    width: clamp(160px, 22vw, 220px);
    margin-inline: auto;
    overflow: hidden;
    border-radius: 18px;
    background: #0a0a0a;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Figma prototype player: wide enough for the flows sidebar + device */
  iframe {
    display: block;
    width: 100%;
    height: clamp(420px, 58vw, 720px);
    border: 0;
    background: var(--paper-200);
  }

  @media (max-width: 760px) {
    iframe {
      height: clamp(480px, 85vh, 720px);
    }
  }

  .media__link {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-small);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    color: var(--ink-500);
  }
</style>
