---
// Case-study hero on the paper sheet (DESIGN.md §6, §8): the big grotesk title, the subtitle, then
// the cover in full colour. (The "CATEGORY / …" label under the title was removed, Kosei 2026-11-03.)
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { pick, type Locale, type Localized } from '../../lib/i18n';
import CoverPlaceholder from '../CoverPlaceholder.astro';

interface Props {
  locale: Locale;
  title: string;
  subtitle?: Localized;
  cover?: ImageMetadata;
  coverAlt?: Localized;
  coverPosition?: string;
  accent?: string;
}

const { locale, title, subtitle, cover, coverAlt, accent } = Astro.props;
---

<header class="case-hero">
  <h1 class="case-hero__title" data-reveal="lines">{title}</h1>
  {subtitle && <p class="case-hero__subtitle" data-reveal="fade">{pick(locale, subtitle)}</p>}
  <div class="case-hero__cover" data-reveal="image">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ? pick(locale, coverAlt) : ''}
          widths={[800, 1200, 1600, 2400]}
          sizes="(min-width: 1440px) 1312px, 92vw"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <CoverPlaceholder locale={locale} title={title} accent={accent} />
      )
    }
  </div>
</header>

<style>
  .case-hero {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: calc(var(--space-10) + var(--space-4)) var(--page-margin) 0;
  }

  .case-hero__title {
    margin: 0;
    max-width: none;
    font-family: var(--font-grotesk);
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .case-hero__subtitle {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-h2);
    line-height: var(--lh-head);
    letter-spacing: var(--tracking-head);
    color: var(--ink-700);
  }

  .case-hero__cover {
    margin-top: var(--space-8);
    overflow: hidden;
    background: var(--paper-200);
  }

  .case-hero__cover :global(img) {
    width: 100%;
    height: auto;
  }
</style>
