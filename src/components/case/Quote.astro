---
// User-research quote: serif italic (the one editorial accent kept from §2), attribution label.
import { text, localeOf, type Text } from '../../lib/i18n';

interface Props {
  by?: Text;
}

const locale = localeOf(Astro.currentLocale);
const { by } = Astro.props;
---

<figure class="quote" data-reveal="fade">
  <blockquote><slot /></blockquote>
  {by && <figcaption>{text(locale, by)}</figcaption>}
</figure>

<style>
  .quote {
    margin: var(--space-7) 0 0;
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-style: italic;
    line-height: 1.25;
  }

  blockquote :global(p) {
    margin: 0;
  }

  figcaption {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-500);
  }
</style>
