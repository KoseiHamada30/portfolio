---
// Numbered case-study section: (0n) + grotesk title + content. Registers itself in the reading
// rail (src/lib/case.ts builds the rail from [data-case-section]).
import { text, localeOf, type Text } from '../../lib/i18n';

interface Props {
  num: string;
  title: Text;
  id: string;
}

const locale = localeOf(Astro.currentLocale);
const { num, title, id } = Astro.props;
const heading = text(locale, title);
---

<section class="case-section" id={id} aria-labelledby={`${id}-title`} data-case-section data-title={heading} data-num={num}>
  <header class="case-section__head">
    <p class="case-section__num">({num})</p>
    <h2 class="case-section__title" id={`${id}-title`} data-reveal="lines">{heading}</h2>
  </header>
  <div class="case-section__body">
    <slot />
  </div>
</section>

<style>
  .case-section {
    padding-top: clamp(var(--space-9), 10vw, var(--space-11));
    scroll-margin-top: var(--space-9);
  }

  .case-section__head {
    margin-bottom: var(--space-6);
  }

  .case-section__num {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    color: var(--ink-500);
  }

  .case-section__title {
    margin: 0;
    max-width: none;
    font-family: var(--font-grotesk);
    font-size: var(--fs-h1);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
</style>
