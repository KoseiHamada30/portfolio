---
// Large handoff link to the next project in the stage order (DESIGN.md §6).
import { Image } from 'astro:assets';
import { t, url, pick, type Locale } from '../../lib/i18n';
import { getStageItems, unbracket } from '../../lib/content';

interface Props {
  locale: Locale;
  current: string;
}

const { locale, current } = Astro.props;
const items = await getStageItems();
const index = items.findIndex((item) => item.id === current);
const next = items[(index + 1) % items.length];
---

<nav class="next" aria-label={t(locale, 'case.next')} data-project={next.accentKey}>
  <a class="next__link" href={url(locale, `work/${next.id}`)}>
    <span class="next__label">{t(locale, 'case.next')}</span>
    <span class="next__title">{next.title}</span>
    {next.category && <span class="next__sub">{unbracket(pick(locale, next.category))}</span>}
    <span class="next__cover" aria-hidden="true">
      {next.cover && <Image src={next.cover} alt="" widths={[480, 960]} sizes="(min-width: 760px) 30vw, 80vw" loading="lazy" style={`object-position: ${next.position}`} />}
    </span>
  </a>
</nav>

<style>
  .next {
    max-width: var(--max-width);
    margin: var(--section-gap) auto 0;
    padding: 0 var(--page-margin) var(--section-gap);
  }

  .next__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30%);
    grid-template-areas:
      'label cover'
      'title cover'
      'sub cover';
    align-content: end;
    gap: var(--space-2) var(--gutter);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .next__label {
    grid-area: label;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .next__title {
    grid-area: title;
    font-family: var(--font-grotesk);
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.055em;
    transition: color var(--dur-base) var(--ease-out);
  }

  .next__link:hover .next__title,
  .next__link:focus-visible .next__title {
    color: var(--accent);
  }

  .next__sub {
    grid-area: sub;
    font-weight: 500;
  }

  .next__cover {
    grid-area: cover;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paper-200);
  }

  .next__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.8s var(--ease-out);
  }

  .next__link:hover .next__cover :global(img) {
    filter: none;
  }

  @media (max-width: 640px) {
    .next__link {
      grid-template-columns: 1fr;
      grid-template-areas: 'cover' 'label' 'title' 'sub';
    }
  }
</style>
