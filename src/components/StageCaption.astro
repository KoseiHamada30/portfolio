---
// Stage slide title: "Circula⁽⁰¹⁾" over "App design" (DESIGN.md §8.2). Used inside each slide
// (native mode) and in the centred title stack, which stage.ts crossfades.
import { t, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  count: string;
  subline: string;
  locale: Locale;
}

const { title, count, subline, locale } = Astro.props;
// Long titles are marked so they can be fitted to narrow screens (kept from the tuner edit, 2026-11-03).
const fit = title.length > 12;
---

<span class="stage__caption">
  <span class="stage__title">
    <span class="stage__title-inner" data-stage-title data-fit={fit ? '' : undefined}>
      {title}
      <sup class="stage__count">({count})</sup>
    </span>
  </span>
  <span class="stage__sub">
    <span class="stage__sub-inner" data-stage-sub>
      {subline ? subline : <span class="stage__todo">{t(locale, 'placeholder.text')}</span>}
    </span>
  </span>
</span>
