---
// First-visit splash (DESIGN.md §8.4–8.5). An overlay above the page: the real page is already in
// the DOM underneath, so nothing waits on the splash to render. Behaviour: src/lib/splash.ts.
// Plays on every full load / refresh of the home page (not on in-site navigation back to it);
// skipped for reduced motion and when JS is off (it needs html.splash-on, which only the inline
// script below can set).
import { t, type Locale } from '../lib/i18n';
import SplashComposition, { type SplashCover } from './SplashComposition.astro';

interface Props {
  locale: Locale;
  covers: SplashCover[];
}

const { locale, covers } = Astro.props;
---

<script is:inline>
  // Decided before first paint. Only a real load or refresh of this page parses this script while
  // readyState is 'loading'; when ClientRouter swaps the home page in (from /info, a case study…)
  // it re-runs this script with readyState 'complete', so in-site navigation never plays it.
  // window.__splashBooted lets the test suites opt out.
  // A language switch (toggle or the remembered-language redirect) sets splash-skip: switching
  // language never replays the splash.
  if (document.readyState === 'loading' && !window.__splashBooted) {
    window.__splashBooted = true;
    var skip = false;
    try {
      skip = sessionStorage.getItem('splash-skip') === '1';
      sessionStorage.removeItem('splash-skip');
    } catch (e) {}
    if (!skip && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('splash-on');
    }
  }
</script>

<div class="splash" aria-hidden="true" data-splash>
  <SplashComposition locale={locale} covers={covers} progress={0} />
  <p class="splash__skip">{t(locale, 'splash.skip')}</p>
</div>

<style>
  .splash {
    display: none;
  }

  :global(html.splash-on) {
    overflow: hidden;
  }

  :global(html.splash-on) .splash {
    position: fixed;
    inset: 0;
    z-index: 950;
    display: block;
    background: var(--paper-200);
    cursor: progress;
  }

  /* Hidden until splash.ts fades it in (avoids a visible → hidden → fade-in flicker). */
  :global(html.splash-on) .splash :global([data-comp]) {
    opacity: 0;
  }

  /* Exit: <main> slides up over the splash (splash.ts) */
  :global(html.splash-exit main) {
    position: relative;
    z-index: 960;
  }

  /* Only visible to people who look for it; any key or click skips. */
  .splash__skip {
    position: absolute;
    top: var(--space-4);
    right: var(--page-margin);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-500);
    opacity: 0;
  }

  .splash:hover .splash__skip {
    opacity: 1;
  }
</style>
