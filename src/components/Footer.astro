---
// Global footer (DESIGN.md §5.9, §6): velocity-aware marquee, click-to-copy email,
// resume, socials and the © line on one row (Kosei 2026-11-03: no clock), auto year. Behaviour in src/lib/footer.ts.
import { t, type Locale } from '../lib/i18n';
import { site } from '../lib/site';
import LinkBullet from './LinkBullet.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const connect = t(locale, 'footer.connect');
const year = new Date().getFullYear();
---

<footer id="contact" class="footer on-inverse">
  <div class="footer__marquee" data-marquee>
    <p class="footer__track" data-marquee-track>
      <span>{connect}</span><span aria-hidden="true">•</span>
      <span aria-hidden="true">{connect}</span><span aria-hidden="true">•</span>
    </p>
  </div>

  <div class="footer__grid">
    <div class="footer__primary">
      <button
        type="button"
        class="link-bullet footer__email"
        data-copy-email={site.email}
        data-copied-label={t(locale, 'footer.copied')}
        data-cursor="copy"
        aria-label={`${t(locale, 'footer.copyEmail')}: ${site.email}`}
      >
        <span class="link-bullet__dot" aria-hidden="true">•</span>
        <span class="link-bullet__label">{site.email}</span>
      </button>
      <LinkBullet href={site.resume} external locale={locale}>{t(locale, 'resume')}</LinkBullet>
    </div>

    <ul class="footer__socials" aria-label={t(locale, 'footer.socials')}>
      <li>
        <a href={site.socials.tiktok} target="_blank" rel="noopener noreferrer" aria-label={`TikTok ${t(locale, 'footer.newTab')}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M19.59 9.17a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.6z"></path>
          </svg>
        </a>
      </li>
      <li>
        <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn ${t(locale, 'footer.newTab')}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      </li>
      <li>
        <a href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </a>
      </li>
    </ul>

    <p class="label footer__meta">{t(locale, 'footer.copyright')} <span data-year>{year}</span></p>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface-inverse);
    color: var(--on-inverse);
    padding-block: var(--space-8) var(--space-6);
    overflow: hidden;
  }

  .footer__marquee {
    font-family: var(--font-display);
    font-size: clamp(4rem, 13vw, 11rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-head);
    margin-block-end: var(--space-8);
  }

  .footer__track {
    margin: 0;
    max-width: none;
  }

  .footer__track span {
    padding-inline: 0.25em;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-6);
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .footer__primary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: var(--fs-body-lg);
  }

  .footer__email {
    color: inherit;
  }

  .footer__socials {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__socials a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: inherit;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .footer__socials a:hover {
    opacity: 0.6;
  }

  .footer__meta {
    margin: 0;
    color: color-mix(in oklab, var(--on-inverse) 65%, transparent);
  }

  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    /* line the icon glyphs up with the links and © line (the 44px hit area pads them in) */
    .footer__socials {
      margin-inline-start: -12px;
    }
  }
</style>
