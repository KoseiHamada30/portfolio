---
// Global nav (DESIGN.md §8): KOSEI© wordmark left; "Work  About" (no comma; active one underlined) and
// language right. Contact sits in the stage's bottom-left corner (Stage.astro) and the footer. Text colour follows the surface: light on the dark Work stage,
// ink on paper pages. Persisted across same-locale navigations; behaviour in src/lib/nav.ts.
import { t, url, otherLocale, pathWithoutLocale, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** False on pages with no translation (/lab, /styleguide): hides the language toggle. */
  alternate?: boolean;
}

const { locale, alternate = true } = Astro.props;
const path = pathWithoutLocale(Astro.url.pathname);
const alt = otherLocale(locale);
const section = path.startsWith('about') ? 'about' : path === '' || path.startsWith('work') ? 'work' : null;
const aboutHref = url(locale, 'about');
---

<header class="nav" data-nav transition:persist={`nav-${locale}`}>
  <div class="nav__inner">
    <a class="nav__brand" href={url(locale)} aria-label={t(locale, 'nav.home')}>K.H.</a>

    <div class="nav__end">
      <nav class="nav__links" aria-label={t(locale, 'nav.primary')}>
        <a class="nav__item" href={url(locale)} data-nav-item="work" aria-current={section === 'work' ? 'page' : undefined}>
          {t(locale, 'nav.work')}
        </a>
        <a class="nav__item" href={aboutHref} data-nav-item="about" aria-current={section === 'about' ? 'page' : undefined}>
          {t(locale, 'nav.about')}
        </a>
        <span class="nav__bar" aria-hidden="true" data-nav-bar></span>
      </nav>
      <a
        class="nav__lang"
        href={url(alt, path)}
        hreflang={alt}
        lang={alt}
        aria-label={t(locale, 'nav.langLabel')}
        data-lang-toggle
        hidden={!alternate}
      >
        <span aria-hidden="true">{t(locale, 'nav.lang')}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 800;
    color: var(--ink-900);
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  :global(body[data-surface='stage']) .nav {
    color: var(--stage-ink);
  }

  /* Blurred paper backdrop after 40px — fades in via opacity only (paper pages) */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--paper-100) 78%, transparent);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .nav:global(.is-scrolled)::before {
    opacity: 1;
  }

  :global(body[data-surface='stage']) .nav::before {
    display: none;
  }

  /* About: before the paper backdrop appears, whatever sits on the portrait is light — the KOSEI©
     wordmark on desktop (the photo fills the left half), the whole nav on phones (photo on top) */
  :global(body[data-page='about']) .nav:not(:global(.is-scrolled)) .nav__brand {
    color: var(--stage-ink);
  }

  @media (max-width: 900px) {
    :global(body[data-page='about']) .nav:not(:global(.is-scrolled)) {
      color: var(--stage-ink);
    }
  }

  .nav:global(.is-hidden) {
    transform: translateY(-100%);
  }

  /* Never hide while something inside has keyboard focus */
  .nav:global(.is-hidden):focus-within {
    transform: none;
  }

  .nav__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--page-margin);
  }

  .nav__brand {
    font-family: var(--font-grotesk);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.055em;
    text-decoration: none;
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav__links {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-4); /* no comma between Work and About (Kosei 2026-11-03) */
    font-weight: 500;
  }


  .nav__item {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .nav__item[aria-current='page'],
  .nav__item:hover {
    text-decoration-color: currentColor;
  }

  /* With JS, one bar marks the current item and slides between Work and About (nav.ts) */
  .nav__bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    background: currentColor;
    transform-origin: 0 0;
    opacity: 0;
    pointer-events: none;
  }

  /* with the bar, no text underline at all (hover moves the bar instead) */
  .nav__links:global(.has-bar) .nav__item {
    text-decoration-color: transparent;
  }

  .nav__links:global(.has-bar) .nav__bar {
    opacity: 1;
  }

  .nav__links:global(.bar-ready) .nav__bar {
    transition:
      transform 450ms var(--ease-out-expo),
      opacity var(--dur-fast) var(--ease-out);
  }

  .nav__lang {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-decoration: none;
  }

  .nav__lang[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .nav__inner {
      padding-block: var(--space-2);
    }

    .nav__end {
      gap: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav::before,
    .nav__links:global(.bar-ready) .nav__bar {
      transition-duration: 0.01ms;
    }
  }
</style>
