---
// Global nav (DESIGN.md §8): KOSEI© wordmark left; "Work, About" (active one underlined),
// language and Contact right. Text colour follows the surface: light on the dark Work stage,
// ink on paper pages. Persisted across same-locale navigations; behaviour in src/lib/nav.ts.
import { t, url, otherLocale, pathWithoutLocale, type Locale } from '../lib/i18n';
import LinkBullet from './LinkBullet.astro';

interface Props {
  locale: Locale;
  /** False on pages with no translation (/lab, /styleguide): hides the language toggle. */
  alternate?: boolean;
}

const { locale, alternate = true } = Astro.props;
const path = pathWithoutLocale(Astro.url.pathname);
const alt = otherLocale(locale);
const section = path.startsWith('info') ? 'info' : path === '' || path.startsWith('work') ? 'work' : null;
// /about arrives in Phase 9; until then "About" is the Info page, where the footer (#contact) lives.
const aboutHref = url(locale, 'info');
---

<header class="nav" data-nav transition:persist={`nav-${locale}`}>
  <div class="nav__inner">
    <a class="nav__brand" href={url(locale)} aria-label={t(locale, 'nav.home')}>KOSEI©</a>

    <div class="nav__end">
      <nav class="nav__links" aria-label={t(locale, 'nav.primary')}>
        <a class="nav__item" href={url(locale)} data-nav-item="work" aria-current={section === 'work' ? 'page' : undefined}>
          {t(locale, 'nav.work')}</a
        ><span class="nav__comma" aria-hidden="true">,</span>
        <a class="nav__item" href={aboutHref} data-nav-item="info" aria-current={section === 'info' ? 'page' : undefined}>
          {t(locale, 'nav.about')}
        </a>
      </nav>
      <a
        class="nav__lang"
        href={url(alt, path)}
        hreflang={alt}
        lang={alt}
        aria-label={t(locale, 'nav.langLabel')}
        data-lang-toggle
        hidden={!alternate}
      >
        <span aria-hidden="true">{t(locale, 'nav.lang')}</span>
      </a>
      <LinkBullet class="nav__contact" href="#contact" data-nav-contact data-fallback={`${aboutHref}#contact`}>
        {t(locale, 'contact')}
      </LinkBullet>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 800;
    color: var(--ink-900);
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  :global(body[data-surface='stage']) .nav {
    color: var(--stage-ink);
  }

  /* Blurred paper backdrop after 40px — fades in via opacity only (paper pages) */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--paper-100) 78%, transparent);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .nav:global(.is-scrolled)::before {
    opacity: 1;
  }

  :global(body[data-surface='stage']) .nav::before {
    display: none;
  }

  .nav:global(.is-hidden) {
    transform: translateY(-100%);
  }

  /* Never hide while something inside has keyboard focus */
  .nav:global(.is-hidden):focus-within {
    transform: none;
  }

  .nav__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--page-margin);
  }

  .nav__brand {
    font-family: var(--font-grotesk);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.055em;
    text-decoration: none;
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav__links {
    display: flex;
    align-items: baseline;
    font-weight: 500;
  }

  .nav__comma {
    margin-inline-end: 0.3em;
  }

  .nav__item {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .nav__item[aria-current='page'],
  .nav__item:hover {
    text-decoration-color: currentColor;
  }

  .nav__lang {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-decoration: none;
  }

  .nav__lang[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .nav__inner {
      padding-block: var(--space-2);
    }

    .nav__end {
      gap: var(--space-3);
    }

    .nav__end :global(.nav__contact) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav::before {
      transition-duration: 0.01ms;
    }
  }
</style>
