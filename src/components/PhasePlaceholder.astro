---
// Phase A placeholder — replaced by the real home page in a later phase.
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  message?: 'home.placeholder' | 'info.placeholder';
}

const { locale, message = 'home.placeholder' } = Astro.props;
---

<section class="container placeholder">
  <p class="label">{t(locale, 'site.role')}</p>
  <h1 class="display">{t(locale, 'site.name')}</h1>
  <p>{t(locale, message)}</p>
</section>

<style>
  .placeholder {
    display: grid;
    gap: var(--space-5);
    padding-block: calc(var(--section-gap) + 64px) var(--section-gap);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
  }
</style>
