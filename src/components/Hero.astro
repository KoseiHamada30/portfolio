---
// Home hero (DESIGN.md §5.2): "KOSEI©" rises letter by letter from masks; behind it a
// CSS gradient blob (replaces v1's 2 MB Fluid-sphere GIF) drifts and leans toward the cursor.
// Behaviour: src/lib/hero.ts.
import { t, url, type Locale } from '../lib/i18n';
import LinkBullet from './LinkBullet.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const letters = [...'KOSEI©'];
---

<section class="hero" data-hero>
  <div class="hero__blob" aria-hidden="true" data-blob>
    <div class="blob">
      <span class="blob__a"></span>
      <span class="blob__b"></span>
      <span class="blob__c"></span>
      <span class="blob__shine"></span>
    </div>
  </div>

  <div class="hero__inner">
    <h1 class="hero__title">
      <span class="visually-hidden">{t(locale, 'site.name')}</span>
      <span class="hero__word" aria-hidden="true" data-hero-title>
        {letters.map((ch) => (
          <span class="hero__mask">
            <span class="hero__char" data-hero-char>{ch}</span>
          </span>
        ))}
      </span>
    </h1>

    <div class="hero__intro">
      <p class="hero__lead" data-reveal="fade" data-reveal-delay="0.5" data-reveal-start="top bottom" set:html={t(locale, 'intro-text')} />
      <div data-reveal="fade" data-reveal-delay="0.6" data-reveal-start="top bottom">
        <LinkBullet href={url(locale, 'about')}>{t(locale, 'home.readStory')}</LinkBullet>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding-block: calc(var(--space-10) + 24px) var(--space-8);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__inner {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-hero);
  }

  .hero__word {
    display: inline-flex;
  }

  /* Each letter rises inside its own mask */
  .hero__mask {
    display: inline-block;
    overflow: hidden;
    padding-block: 0.04em 0.08em;
    margin-block: -0.04em -0.08em;
  }

  .hero__char {
    display: inline-block;
    will-change: transform;
  }

  :global(.js) [data-hero-title] {
    opacity: 0;
  }

  .hero__intro {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-block-start: var(--space-6);
    max-width: 34rem;
  }

  .hero__lead {
    font-size: var(--fs-body-lg);
  }

  .hero__lead :global(b) {
    font-weight: 600;
  }

  /* ---------------------------------------------------------------- blob */

  .hero__blob {
    position: absolute;
    z-index: -1;
    top: 18%;
    right: clamp(-12%, 6vw - 6rem, 10%);
    width: clamp(240px, 36vw, 540px);
    aspect-ratio: 1;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .hero__blob:global(.is-ready) {
    opacity: 1;
  }

  .blob {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    filter: blur(22px);
    opacity: 0.85;
  }

  .blob span {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: multiply;
    animation: drift 18s var(--ease-in-out) infinite alternate;
  }

  .blob__a {
    inset: 8% 14% 18% 6%;
    background: radial-gradient(circle at 35% 35%, #e4e6ff, #ccd2ff 45%, transparent 70%);
  }

  .blob__b {
    inset: 18% 4% 6% 22%;
    background: radial-gradient(circle at 60% 40%, #dbf3ff, #c3e8ff 45%, transparent 70%);
    animation-duration: 22s;
    animation-delay: -6s;
  }

  .blob__c {
    inset: 30% 20% 2% 12%;
    background: radial-gradient(circle at 50% 60%, #ffe6f4, #f9d6ee 40%, transparent 70%);
    animation-duration: 26s;
    animation-delay: -12s;
  }

  .blob__shine {
    inset: 14% 34% 46% 18%;
    background: radial-gradient(circle, rgb(255 255 255 / 0.95), transparent 70%);
    mix-blend-mode: normal !important;
    animation-duration: 15s;
  }

  @keyframes drift {
    0% {
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate(4%, -3%) rotate(40deg) scale(1.06);
    }
    100% {
      transform: translate(-3%, 4%) rotate(-25deg) scale(0.95);
    }
  }

  @media (max-width: 640px) {
    .hero__blob {
      top: 22%;
      right: -18%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob span {
      animation: none;
    }
  }
</style>
