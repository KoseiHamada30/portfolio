---
import { getCollection } from 'astro:content';
import WorkPage from '../../components/WorkPage.astro';

export async function getStaticPaths() {
  // Side quests get the same placeholder page so their stage slides have somewhere to link.
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const quests = await getCollection('sidequests', ({ data }) => !data.draft);
  return [...projects, ...quests].map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
---

<WorkPage project={project} locale="en" />
